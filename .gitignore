# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android release-signing material. Keystores and their passwords must stay
# local (or in GitHub Actions secrets), never in the repository.
/android/key.properties
/android/app/*.jks
/android/app/*.keystore
